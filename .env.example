# Copy to .env and fill in. Only ONE LLM key is needed. Without any key the app runs in offline (extractive) mode.

# ---- LLM (auto = first provider with a key: Groq -> Gemini -> OpenAI -> Claude) ----
# If one provider hits its free-tier limit, the app automatically falls back to another one that has a key.
LLM_PROVIDER=auto
GROQ_API_KEY=              # free, no card: https://console.groq.com/keys
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=            # free key: https://aistudio.google.com/apikey
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_TEMPERATURE=0.2

# ---- Embeddings: auto | sentence-transformers | gemini | openai | hashing ----
EMBEDDING_PROVIDER=auto
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Vector store: auto (ChromaDB if installed) | chroma | numpy ----
VECTOR_STORE=auto

# ---- Chunking & retrieval ----
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=5
HISTORY_TURNS=4
